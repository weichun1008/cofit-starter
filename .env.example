# ============================================================
# 複製成 .env.local 後填入實際值。.env.local 已被 .gitignore，不會進版控。
# 全部留空也能跑：DB 走記憶體、AI/LINE 功能自動略過。
# ============================================================

# --- 資料庫（Neon / Vercel Postgres）。留空 = 本機記憶體模式 ---
POSTGRES_URL=

# --- 認證：JWT 簽章密鑰（正式環境務必改成隨機長字串）---
JWT_SECRET=change-me-to-a-long-random-string

# --- Gemini AI（/api/analyze 用）。留空 = AI 功能停用 ---
GEMINI_API_KEY=

# --- LINE Bot 推播（/api/notify 用）。留空 = 推播自動略過 ---
LINE_CHANNEL_ACCESS_TOKEN=

# --- LINE LIFF：每個模組一個 LIFF ID（對應 lib/config.js 的 LIFF_ROUTES）---
NEXT_PUBLIC_LIFF_ID_EXAMPLE=
